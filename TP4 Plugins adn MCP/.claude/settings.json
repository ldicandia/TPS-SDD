{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-gate.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__gcs__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gcs-allowlist.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
