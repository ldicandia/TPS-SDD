{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/spec-gate.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__plugin_gcsgrep-sdd_gcs__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gcs-allowlist.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
